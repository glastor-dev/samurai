{
  "name": "@glastor-dev/samurai",
  "version": "1.0.0",
  "description": "Enterprise GitHub 2026 Standards & Governance Generator for Deno and JSR",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/mod.ts",
    "./cli": "./src/cli.ts"
  },
  "publish": {
    "include": [
      "src/",
      "deno.json",
      "README.md",
      "LICENSE"
    ],
    "exclude": [
      "tests/",
      ".github/",
      "dist/"
    ]
  },
  "tasks": {
    "start": "deno run -A src/cli.ts",
    "init": "deno run -A src/cli.ts init",
    "hybrid": "deno run -A src/cli.ts hybrid",
    "org-init": "deno run -A src/cli.ts org-init",
    "doctor": "deno run -A src/cli.ts doctor",
    "wizard": "deno run -A src/cli.ts wizard",
    "update": "deno run -A src/cli.ts update",
    "test": "deno test -A tests/",
    "check": "deno check src/mod.ts src/cli.ts",
    "fmt": "deno fmt",
    "lint": "deno lint"
  },
  "imports": {
    "@std/path": "jsr:@std/path@^1.0.8",
    "@std/fs": "jsr:@std/fs@^1.0.8",
    "@std/cli": "jsr:@std/cli@^1.0.9",
    "@std/fmt": "jsr:@std/fmt@^1.0.5",
    "@std/assert": "jsr:@std/assert@^1.0.11"
  }
}
